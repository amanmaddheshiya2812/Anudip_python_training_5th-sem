'''Tasks 
Write a program to: 
1. Extract username.  
2. Extract domain name.  
3. Extract extension.  
4. Count digits present in username.  
5. Count special characters.  
6. Check whether:  
o Exactly one '@' exists.  
o At least one '.' exists after '@'. '''
email = input("Enter an email address: ").strip()

# 6. Check validation criteria
at_count = email.count('@')
has_dot_after_at = False

if at_count == 1:
    parts = email.split('@')
    username_part = parts[0]
    domain_part = parts[1]
    
    if '.' in domain_part:
        has_dot_after_at = True
        
        # 1, 2, 3. Extract components based on the last dot
        dot_index = domain_part.rfind('.')
        domain = domain_part[:dot_index]
        extension = domain_part[dot_index+1:]
        
        # 4. Count digits in username
        digits_count = 0
        for char in username_part:
            if char.isdigit():
                digits_count += 1
        
        # 5. Count special characters (ignores @, counts dots/symbols)
        special_chars = 0
        for char in email:
            if not char.isalnum() and char != '@':
                special_chars += 1
        
        # 7. Display Results for Valid Email
        print(f"\nEmail: {email}")
        print(f"Username: {username_part}")
        print(f"Domain: {domain}")
        print(f"Extension: {extension}")
        print(f"Digits Found: {digits_count}")
        print(f"Special Characters Found: {special_chars}")
        print("Email Status: Valid")
    else:
        print(f"\nEmail: {email}")
        print("Email Status: Invalid Email")
else:
    print(f"\nEmail: {email}")
    print("Email Status: Invalid Email")