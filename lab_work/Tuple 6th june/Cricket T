# Cricket Tournament Scorecard
scores = [45, 78, 12, 100, 67, 8, 90, 55]

# Count half-centuries and centuries
half_centuries = sum(1 for s in scores if 50 <= s < 100)
centuries = sum(1 for s in scores if s >= 100)

print(f"Half-centuries: {half_centuries}")
print(f"Centuries: {centuries}")

# Find the highest score
highest_score = max(scores)
print(f"Highest Score: {highest_score}")

# Display all scores below 20
low_scores = [s for s in scores if s < 20]
print(f"Scores below 20: {low_scores}")

# Calculate the average score
average_score = sum(scores) / len(scores)
print(f"Average Score: {average_score:.2f}")
